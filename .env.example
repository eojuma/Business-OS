APP_ENV=development
APP_PORT=8080
# Comma-separated list of allowed browser origins.
# Local dev origins (http://localhost:3000, http://127.0.0.1:3000) are always allowed.
FRONTEND_URL=http://localhost:3000,https://business-os-tqu3.onrender.com

DB_HOST=postgres
DB_PORT=5432
DB_USER=businessos
DB_PASSWORD=businessos
DB_NAME=businessos
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=24

# The assistant speaks the OpenAI Chat Completions format, so any
# OpenAI-compatible provider works. Set AI_BASE_URL and AI_MODEL to match
# the provider you use. AI_API_KEY is required or /assistant/* returns 500.
# Gemini (OpenAI-compatible endpoint):
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI (alternative):
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1