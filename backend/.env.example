APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000,https://business-os-tqu3.onrender.com
# Public origin of this API. M-Pesa callback URLs are built from it when no
# provider-specific URL is configured below.
BACKEND_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=businessos
DB_PASSWORD=businessos
DB_NAME=businessos
DB_SSLMODE=disable

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=24

GOOGLE_CLIENT_ID=

# Email verification (required in production so sign-ups can confirm their address)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Business OS <no-reply@example.com>
SMTP_TLS=true
EMAIL_VERIFICATION_TTL_HOURS=24

AI_PROVIDER=gemini
AI_API_KEY=your-key
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_OCR_MODEL=
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty when direct.
TRUSTED_PROXIES=

# M-Pesa (Daraja). Callback URLs are optional: when omitted they are built from
# BACKEND_URL and the callback token is appended automatically.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_SECRET=
MPESA_STK_CALLBACK_URL=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=
